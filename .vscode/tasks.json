{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build SFML (Debug)",
            "type": "shell",
            "command": "cl",
            "args": [
                "/nologo",
                "/EHsc",
                "/std:c++17",
                "/MDd",
                "/Zi",
                "/Od",
                "/IC:\\Users\\David\\Documents\\GitHub\\SFML-2.6.2\\include",
                "${workspaceFolder}\\src\\main.cpp",
                "/Fe:\"${workspaceFolder}\\build e obj\\main.exe\"",
                "/Fo\"${workspaceFolder}\\build e obj\\main.obj\"",
                "/Fd\"${workspaceFolder}\\build e obj\\main.pdb\"",
                "/link",
                "/DEBUG",
                "/LIBPATH:C:\\Users\\David\\Documents\\GitHub\\SFML-2.6.2\\lib",
                "sfml-graphics-d.lib",
                "sfml-window-d.lib",
                "sfml-audio-d.lib",
                "sfml-network-d.lib",
                "sfml-system-d.lib"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe arquivo de build ativo",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tarefa gerada pelo Depurador."
        }
    ]
}