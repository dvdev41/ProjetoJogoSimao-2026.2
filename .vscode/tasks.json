{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build SFML (Debug)",
            "type": "process",
            "command": "cl.exe",
            "args": [
                "/nologo",
                "/EHsc",
                "/std:c++14",
                "/MDd",
                "/Zi",
                "/Od",
                "/I${workspaceFolder}\\headers",
                "/I${workspaceFolder}\\sfml\\include",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\Jogo.cpp",
                "${workspaceFolder}\\src\\Jogador.cpp",
                "${workspaceFolder}\\src\\Gerenciador_Grafico.cpp",
                "/Fe${workspaceFolder}\\build e obj\\main.exe",
                "/Fd${workspaceFolder}\\build e obj\\main.pdb",
                "/link",
                "/DEBUG",
                "/LIBPATH:${workspaceFolder}\\sfml\\bin",
                "sfml-graphics-d.lib",
                "sfml-window-d.lib",
                "sfml-system-d.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\build e obj"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}
